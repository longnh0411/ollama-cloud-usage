{
  "name": "ollama-cloud-usage",
  "displayName": "Ollama Cloud Usage",
  "description": "View Ollama Cloud usage and limits in VS Code.",
  "version": "1.1.1",
  "publisher": "ollama-cloud-usage",
  "author": {
    "name": "LongNH94",
    "email": "longnh94@fpt.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/longnh0411/ollama-cloud-usage.git"
  },
  "bugs": {
    "url": "https://github.com/longnh0411/ollama-cloud-usage/issues"
  },
  "homepage": "https://github.com/longnh0411/ollama-cloud-usage#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ollama",
    "ollama-cloud",
    "usage",
    "quota",
    "monitoring"
  ],
  "icon": "resources/ollama-cloud.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ollamaCloud.refresh",
        "title": "Ollama Cloud: Refresh Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "ollamaCloud.addAccount",
        "title": "Ollama Cloud: Add Account",
        "icon": "$(add)"
      },
      {
        "command": "ollamaCloud.removeAccount",
        "title": "Ollama Cloud: Remove Account",
        "icon": "$(trash)"
      },
      {
        "command": "ollamaCloud.openPanel",
        "title": "Ollama Cloud: Open Usage Panel",
        "icon": "$(layout-sidebar-left)"
      }
    ],
    "menus": {}
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/api.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2"
  }
}
